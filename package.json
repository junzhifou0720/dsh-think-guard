{
  "name": "dsh-think-guard",
  "version": "0.5.0",
  "description": "DSH 长会话的思考护栏 + 投影层清洗：按词表把仪式句从每轮注入里删掉（断掉自我强化），只掐真正失控的超长思考，并在自动压缩后提醒手动清创。不改会话日志，关掉即恢复。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "reasoning",
    "loop",
    "degeneration",
    "guard",
    "context-projection",
    "compaction"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
